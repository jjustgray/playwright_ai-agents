= raw.framework\n  }\n  if (typeof raw.updatedAt === 'string' && raw.updatedAt) {\n    normalized.updatedAt = raw.updatedAt\n  }\n  return normalized\n}\n","import { embedParentOriginMatchesMessage } from '../embed_parent_origin'\n\nimport { normalizeHostConsent } from './consent_normalize'\n\n/** Parent → iframe embed consent update (CalendlyConsentUpdateV1). */\nconst CONSENT_UPDATE_MESSAGE_EVENT = 'calendly.consent.update.v1'\n\nlet lastConsentUpdate = null\nconst subscribers = new Set()\n\nconst notifySubscriber = (callback, payload) => {\n  try {\n    callback(payload)\n  } catch {\n    /* noop */\n  }\n}\n\nconst dispatchConsentUpdateToSubscribers = (payload) => {\n  lastConsentUpdate = payload\n  subscribers.forEach((cb) => {\n    notifySubscriber(cb, payload)\n  })\n}\n\n/**\n * Handles a message from the parent window to update the embed's consent state.\n * Messages are only applied when the URL's `embed_domain` matches the postMessage origin.\n * @param {MessageEvent} event\n */\nexport const handleConsentUpdateMessage = (event) => {\n  if (!event?.data || event.data.type !== CONSENT_UPDATE_MESSAGE_EVENT) return\n  if (!embedParentOriginMatchesMessage(window.location.search, event.origin)) return\n\n  const normalized = normalizeHostConsent(event.data.consent)\n  if (!normalized) return\n  dispatchConsentUpdateToSubscribers(normalized)\n}\n\n/**\n * Subscribe to consent updates. If a consent update has already been received, the subscriber\n * is invoked synchronously with the last value so late mounters can read the current state.\n * @param {(payload: object) => void} callback\n * @returns {() => void} unsubscribe\n */\nexport const subscribeConsentUpdate = (callback) => {\n  subscribers.add(callback)\n  if (lastConsentUpdate) notifySubscriber(callback, lastConsentUpdate)\n  return () => subscribers.delete(callback)\n}\n","/**\n * Centralized embed consent module.\n *\n * Combines two consent inputs into a single resolved ConsentState that consumers\n * (analytics, marketing, etc.) can read or subscribe to:\n *\n *   1. Host CMP (Consent Management Platform) — the embedding page tells us about its visitor's consent via the\n *      `calendly.consent.update.v1` postMessage. Normalized via `consent_normalize.js`.\n *   2. Calendly's own OneTrust integration — runtime active groups from the OneTrust\n *      script (mapped from C00xx group IDs to IAB-style (Interactive Advertising Bureau) category aliases).\n *\n * Precedence (per category):\n *   - If the host has emitted a categorical decision ('granted' or 'denied'), host wins.\n *   - If the host has emitted 'unknown' for a category, fall back to OneTrust for that\n *     category.\n *   - If neither has emitted a decision for a category, apply the unknown-state policy.\n *\n * Unknown-state policy (when no signal exists for a category):\n *   - necessary    -> 'granted' (necessary cookies are always allowed; matches GDPR norms)\n *   - functional   -> 'denied'\n *   - performance  -> 'denied'\n *   - targeting    -> 'denied'\n *\n * Resolved categories never expose 'unknown' — getState() always returns a binary\n * 'granted' | 'denied' decision per category so consumers don't need to reimplement\n * the unknown policy themselves.\n *\n * Provenance (`source` on the resolved state):\n *   - 'host'     if any host signal is set\n *   - 'onetrust' if no host signal and any OneTrust signal is set\n *   - 'default'  if neither has emitted anything (state is the unknown-state policy default)\n *\n * onChange semantics: fires only on real resolved-state changes. Updates that produce a\n * structurally identical resolved state (e.g. host re-emits the same categories with a\n * different `updatedAt`, or framework alone changes) do NOT fire subscribers. This\n * matches the \"fires only on real state changes\" acceptance criterion.\n */\n\nimport { parseQuery } from '@calendly/http-tools'\n\nimport { getVendorStatuses } from '../vendors/vendor_runtime'\n\nimport { CONSENT_CATEGORIES, normalizeHostConsent } from './consent_normalize'\n\nconst UNKNOWN_STATE_POLICY = Object.freeze({\n  necessary: 'granted',\n  functional: 'denied',\n  performance: 'denied',\n  targeting: 'denied',\n})\n\n// OneTrust group IDs → IAB-style category aliases. Mirrors @calendly/onetrust's\n// internal mapping (functional/performance/targeting) and adds the standard\n// necessary group (C0001), which OneTrust treats as always-on but does emit when\n// the visitor has accepted.\nconst ONETRUST_GROUP_TO_CATEGORY = Object.freeze({\n  C0001: 'necessary',\n  C0002: 'performance',\n  C0003: 'functional',\n  C0004: 'targeting',\n})\n\n/**\n * Normalize the OneTrust input passed to `updateFromOneTrust`. Accepts:\n *   - `null` to clear the OneTrust signal entirely.\n *   - `{ activeGroups: string[] }` (the shape produced by `@calendly/onetrust`'s\n *     redux slice as well as the `Onetrust` component's `setActiveGroups` callback).\n *   - `string[]` directly, for callers that have just the active-groups list.\n *\n * Categories not represented by an active group are emitted as 'denied'. Necessary\n * is special-cased to 'granted' if it's missing (OneTrust often omits it from the\n * activeGroups array because it's always-on; treating absence as denied would be\n * incorrect).\n */\nconst normalizeOneTrustInput = (input) => {\n  if (input == null) return null\n\n  let activeGroups\n  if (Array.isArray(input)) {\n    activeGroups = input\n  } else if (input && typeof input === 'object' && Array.isArray(input.activeGroups)) {\n    activeGroups = input.activeGroups\n  } else {\n    return null\n  }\n\n  const groupSet = new Set(activeGroups.filter((g) => typeof g === 'string'))\n  const categories = {}\n  CONSENT_CATEGORIES.forEach((category) => {\n    const groupId = Object.keys(ONETRUST_GROUP_TO_CATEGORY)\n      .find((id) => ONETRUST_GROUP_TO_CATEGORY[id] === category)\n    if (groupId && groupSet.has(groupId)) {\n      categories[category] = 'granted'\n    } else if (category === 'necessary') {\n      categories[category] = 'granted'\n    } else {\n      categories[category] = 'denied'\n    }\n  })\n\n  return { categories }\n}\n\nconst resolveCategory = (category, host, onetrust) => {\n  const hostValue = host?.categories?.[category]\n  if (hostValue === 'granted' || hostValue === 'denied') return hostValue\n\n  // hostValue is 'unknown' OR host has no opinion for this category → fall back to OneTrust.\n  const onetrustValue = onetrust?.categories?.[category]\n  if (onetrustValue === 'granted' || onetrustValue === 'denied') return onetrustValue\n\n  return UNKNOWN_STATE_POLICY[category]\n}\n\nconst resolveSource = (host, onetrust) => {\n  if (host) return 'host'\n  if (onetrust) return 'onetrust'\n  return 'default'\n}\n\nconst buildResolvedState = (host, onetrust) => {\n  const categories = {}\n  CONSENT_CATEGORIES.forEach((category) => {\n    categories[category] = resolveCategory(category, host, onetrust)\n  })\n  return {\n    categories,\n    source: resolveSource(host, onetrust),\n    host,\n    onetrust,\n  }\n}\n\n// onChange-equality: compare resolved categories + source. We deliberately ignore\n// `host.updatedAt`, `host.framework`, and the raw input shapes so subscribers don't\n// fire when only metadata changed. If a consumer later needs metadata-level change\n// detection, expose a separate subscribe API for it.\nconst resolvedStatesEqual = (a, b) => {\n  if (a.source !== b.source) return false\n  for (let i = 0; i < CONSENT_CATEGORIES.length; i += 1) {\n    const k = CONSENT_CATEGORIES[i]\n    if (a.categories[k] !== b.categories[k]) return false\n  }\n  return true\n}\n\nexport const createConsentModule = () => {\n  let host = null\n  let onetrust = null\n  let state = buildResolvedState(host, onetrust)\n  const subscribers = new Set()\n\n  const notify = () => {\n    subscribers.forEach((cb) => {\n      try {\n        cb(state)\n      } catch {\n        /* noop — one bad subscriber must not break the rest */\n      }\n    })\n  }\n\n  const recompute = () => {\n    const next = buildResolvedState(host, onetrust)\n    if (resolvedStatesEqual(state, next)) {\n      // Still update the stored snapshot so callers reading getState() see the latest\n      // raw inputs (host.updatedAt, framework, etc.) even when resolved state is unchanged.\n      state = next\n      return\n    }\n    state = next\n    notify()\n  }\n\n  return {\n    getState: () => state,\n\n    /**\n     * Apply a host CMP signal. Pass the raw v1 `consent` payload (i.e. `data.consent`\n     * from a `calendly.consent.update.v1` postMessage). Pass `null` to clear.\n     * Invalid payloads (missing source, no recognized categories) are dropped silently.\n     */\n    updateFromHost: (raw) => {\n      const next = raw == null ? null : normalizeHostConsent(raw)\n      if (raw != null && next == null) return\n      host = next\n      recompute()\n    },\n\n    /**\n     * Apply a OneTrust signal. Accepts `{ activeGroups: string[] }`, a bare string[],\n     * or `null` to clear.\n     */\n    updateFromOneTrust: (input) => {\n      const next = normalizeOneTrustInput(input)\n      onetrust = next\n      recompute()\n    },\n\n    onChange: (callback) => {\n      subscribers.add(callback)\n      return () => subscribers.delete(callback)\n    },\n\n    /**\n     * Runtime activation status for every vendor in the catalog, derived from\n     * the current resolved categories plus optional runtime context (feature\n     * flags, initialization probes). See `vendor_runtime.js`.\n     *\n     * @param {import('../vendors/vendor_runtime').VendorRuntimeContext} [context]\n     * @returns {import('../vendors/vendor_runtime').VendorRuntimeStatus[]}\n     */\n    getVendorStatuses: (context) => getVendorStatuses(state.categories, context),\n  }\n}\n\n/**\n * Default singleton consent module. Use this for app-wide reads/writes; use\n * `createConsentModule()` directly for tests or scoped instances.\n */\nexport const consentModule = createConsentModule()\n\n// Backward-compat: synchronously seed the singleton when the iframe was loaded with\n// `hide_gdpr_banner=true` AND a real embed context (`embed_domain` + `embed_type`),\n// and the host has not yet sent a `calendly.consent.update.v1` message. Runs at\n// module evaluation so `getState()` returns the seeded state immediately — matching\n// the synchronous bypass the legacy `shouldHideOnetrustSelector` provided.\n//\n// The legacy selector required `shouldHide && isEmbedded` (see `selectors/gdpr.js`\n// pre-refactor), where `isEmbedded` was derived from `embed_domain && embed_type`\n// in `reducers/gdpr.js`. We preserve that two-factor gate so a non-embedded page\n// that carries `?hide_gdpr_banner=true` does not silently grant every category —\n// that would be a privacy regression vs. the old selector. The matching gate in\n// `reducers/consent.js` keeps Redux in sync from the very first render; this keeps\n// anything that reads `consentModule` directly (e.g. `ConsentStatePublisher`) on\n// the same page. Performed in try/catch so a malformed URL can never break module\n// evaluation.\ntry {\n  if (typeof window !== 'undefined') {\n    const {\n      hide_gdpr_banner: hideGdprBanner,\n      embed_domain: embedDomain,\n      embed_type: embedType,\n    } = parseQuery(window.location.search)\n    if (hideGdprBanner && embedDomain && embedType) {\n      consentModule.updateFromHost({\n        source: 'hide_gdpr_banner',\n        categories: Object.fromEntries(CONSENT_CATEGORIES.map((c) => [c, 'granted'])),\n      })\n    }\n  }\n} catch {\n  /* noop — module evaluation must never throw */\n}\n","import { useEffect } from 'react'\nimport { useFlag } from '@calendly/feature-check-react'\n\nimport {\n  handleConsentUpdateMessage,\n  subscribeConsentUpdate,\n} from 'services/consent/consent_update_handoff'\nimport { consentModule } from 'services/consent/consent_module'\n\n/**\n * Registers window message listener for updating embed consent. Messages are only applied\n * when embed_domain on the URL matches the postMessage origin (see consent_update_handoff).\n *\n * When the `sa_consent_aware_embed` flag is on, also forwards normalized consent updates from\n * the transport into the centralized consent module so consumers (analytics, marketing, etc.)\n * can read a single resolved ConsentState. When the flag is off, the transport still\n * registers the listener but the module is not fed — keeping the new module dark for the\n * initial rollout per SA-3901's \"introduce behind a feature flag and wire minimally\" plan.\n */\nexport const ConsentUpdateMessageListener = () => {\n  const consentModuleEnabled = useFlag('sa_consent_aware_embed', false)\n\n  useEffect(() => {\n    window.addEventListener('message', handleConsentUpdateMessage)\n    return () => window.removeEventListener('message', handleConsentUpdateMessage)\n  }, [])\n\n  useEffect(() => {\n    if (!consentModuleEnabled) return undefined\n    return subscribeConsentUpdate((payload) => {\n      consentModule.updateFromHost(payload)\n    })\n  }, [consentModuleEnabled])\n\n  return null\n}\n","import { embedParentOriginMatchesMessage } from '../embed_parent_origin'\nimport { getVendorStatuses } from '../vendors/vendor_runtime'\n\n/**\n * Iframe → parent embed consent state messaging.\n *\n * The embedded booking page already maintains a resolved `ConsentState`\n * via `consent_module.js`. This transport exposes that state to the embedding\n * host so it can observe the effective consent the iframe is operating with\n * (after the host CMP + Calendly OneTrust precedence has been applied).\n *\n * Wire contract\n * -------------\n * Parent → iframe (request a snapshot, and subscribe to subsequent changes):\n *\n *   {\n *     type: 'calendly.consent.state.get.v1',\n *   }\n *\n * Iframe → parent (snapshot/notification):\n *\n *   {\n *     type: 'calendly.consent.state.v1',\n *     state: {\n *       // Resolved (always 'granted' | 'denied' per category)\n *       categories: { necessary, functional, performance, targeting },\n *       source: 'host' | 'onetrust' | 'default',\n *       // Raw inputs that produced the resolution (informational; shape may\n *       // evolve — consumers should depend on `categories`/`source`).\n *       host: null | { source, categories, framework?, updatedAt? },\n *       onetrust: null | { categories },\n *       vendors: VendorRuntimeStatus[],\n *     },\n *   }\n *\n * Security model: identical to the inbound `calendly.consent.update.v1`\n * listener. We only respond to a request when the request's origin host matches\n * the `embed_domain` query parameter on the iframe URL (which `widget.js` sets\n * from the embedding host). Subsequent change notifications are sent only to\n * that verified origin via `window.parent.postMessage(..., verifiedOrigin)`.\n *\n * Subscription is implicit: sending a `get.v1` request both fetches the current\n * snapshot AND opts the parent in to future change notifications until the\n * iframe is torn down. Sending another `get.v1` from the same parent is a\n * no-op for subscription but always returns a fresh snapshot.\n */\n\nconst STATE_REQUEST_MESSAGE_EVENT = 'calendly.consent.state.get.v1'\nconst STATE_MESSAGE_EVENT = 'calendly.consent.state.v1'\n\nlet verifiedParentOrigin = null\n\n/** @type {import('../vendors/vendor_runtime').VendorRuntimeContext} */\nlet vendorRuntimeContext = {}\n\n/**\n * Update runtime inputs used when building the `vendors` array on state payloads.\n * Called from React components that own feature-flag state (e.g. ConsentStatePublisher).\n *\n * @param {import('../vendors/vendor_runtime').VendorRuntimeContext} context\n */\nexport const setVendorRuntimeContext = (context) => {\n  vendorRuntimeContext = context ?? {}\n}\n\nconst buildPayload = (state) => ({\n  type: STATE_MESSAGE_EVENT,\n  state: {\n    categories: state.categories,\n    source: state.source,\n    host: state.host,\n    onetrust: state.onetrust,\n    vendors: getVendorStatuses(state.categories, vendorRuntimeContext),\n  },\n})\n\nconst canPostToParent = () => (\n  typeof window !== 'undefined' && window.parent && window.parent !== window\n)\n\nconst postToParent = (payload, targetOrigin) => {\n  if (!canPostToParent()) return\n  try {\n    window.parent.postMessage(payload, targetOrigin)\n  } catch {\n    /* noop — a broken parent must not break the iframe */\n  }\n}\n\n/**\n * Handle a parent → iframe state request. Verifies origin, records the parent\n * as a subscriber, and replies with the current resolved state.\n *\n * @param {MessageEvent} event\n * @param {() => object} getState\n */\nexport const handleConsentStateRequest = (event, getState) => {\n  if (!event?.data || event.data.type !== STATE_REQUEST_MESSAGE_EVENT) return\n  if (!embedParentOriginMatchesMessage(window.location.search, event.origin)) return\n\n  verifiedParentOrigin = event.origin\n  postToParent(buildPayload(getState()), verifiedParentOrigin)\n}\n\n/**\n * Publish a resolved state change to the verified parent. No-op when no parent\n * has subscribed (no `get.v1` has been received yet), so unsolicited state is\n * never broadcast to `*`.\n *\n * @param {object} state Resolved ConsentState from consentModule.getState()\n */\nexport const publishConsentState = (state) => {\n  if (!verifiedParentOrigin) return\n  postToParent(buildPayload(state), verifiedParentOrigin)\n}\n\n/** Test-only: clear the recorded subscriber between tests. */\nexport const resetConsentStatePublisherForTests = () => {\n  verifiedParentOrigin = null\n  vendorRuntimeContext = {}\n}\n","import { useEffect, useMemo, useState } from 'react'\nimport { parseQuery } from '@calendly/http-tools'\nimport { useNewCode } from '@calendly/feature-check-react'\n\nimport { consentModule } from 'services/consent/consent_module'\nimport { setVendorRuntimeContext } from 'services/consent/consent_state_publish'\nimport { onVendorRuntimeChange } from 'services/vendors/ve