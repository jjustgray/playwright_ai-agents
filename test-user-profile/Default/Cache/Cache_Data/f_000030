dow.location.search).embed_domain,\n    embed_type: parseQuery(window.location.search).embed_type,\n    scheduling_link_uuid: schedulingLink?.uid\n  }\n\n  if (duration) params.duration_override = duration\n\n  if (eventTypeSelector(state).booking_method === BOOKING_METHODS.poll) {\n    params.rescheduling = buildPollRevoteParams(state)\n  }\n\n  if (isReschedulingSelector(state)) params.rescheduling = buildReschedulingParams(state)\n\n  return params\n}\n\nconst fetchCalendarRange = (eventType, params, pathSegment = 'calendar') => (\n  httpRequest({\n    url: `/api/booking/event_types/${eventType.uuid}/${pathSegment}/range`,\n    type: 'GET',\n    params\n  })\n)\n\nexport const fetchRangeData = (state, range, duration) => (\n  fetchCalendarRange(eventTypeSelector(state), buildParams(state, range, duration))\n)\n\n/** Run async fn for each item sequentially; use when parallel calls are restricted (e.g. Microsoft). */\nexport const runSequentially = (items, fn) => items.reduce(\n  (promise, item) => promise.then((results) => fn(item).then((result) => [...results, result])),\n  Promise.resolve([])\n)\n\nexport const fetchAvailabilityTracings = (state, range, duration) => {\n  const params = {\n    ...buildParams(state, range, duration),\n    diagnostics: true // Always enable diagnostics for tracings\n  }\n  return fetchCalendarRange(eventTypeSelector(state), params, 'calendar_tracings')\n}\n\nexport const getMonthGetParam = () => {\n  const { month } = parseQuery(window.location.search)\n  return month\n}\n\nconst wrapRangesInStrings = (ranges, monthId, timezone) => {\n  const monthDt = parseInTimezone(monthId, timezone)\n\n  return ranges.map((range) => {\n    const start = toDateId(monthDt.set({ day: range.start }))\n    const end = toDateId(monthDt.set({ day: range.end }))\n    return [start, end]\n  })\n}\n\nconst validateInputs = (monthId, timezone) => {\n  if (typeof monthId !== 'string' || !/^\\d{4}-\\d{2}-\\d{2}$/.test(monthId)) throw new Error(`Invalid monthId: ${monthId}`)\n  if (!timezone || !isValidTimezone(timezone)) throw new Error(`Invalid timezone: ${timezone}`)\n\n  const monthDt = parseInTimezone(monthId, timezone)\n  if (!monthDt?.isValid) throw new Error(`Invalid monthId: ${monthId}`)\n\n  return monthDt\n}\n\nexport const buildRanges = (monthId, isMultiRange, isFullMonth, timezone) => {\n  const monthDt = validateInputs(monthId, timezone)\n  const currentTime = now(timezone)\n  const fullMonth = isFullMonth || toDateId(startOfMonth(currentTime)) !== monthId\n  const periodStartDay = fullMonth ? 1 : Math.min(currentTime.day, monthDt.daysInMonth)\n  const periodEndDay = monthDt.daysInMonth\n  const totalRanges = Math.ceil((periodEndDay - periodStartDay + 1) / DAYS_IN_BATCH)\n\n  if (!isMultiRange || totalRanges < 1) return wrapRangesInStrings([{ start: periodStartDay, end: periodEndDay }], monthId, timezone)\n\n  const ranges = [...Array(totalRanges)].map((_, index) => ({\n    start: periodStartDay + DAYS_IN_BATCH * index,\n    end: Math.min(periodEndDay, periodStartDay + DAYS_IN_BATCH * index + DAYS_IN_BATCH - 1)\n  }))\n\n  const last = ranges[totalRanges - 1]\n  const penultimate = ranges[totalRanges - 2]\n  const lastRangeTooShort = totalRanges > 1 && (last.end - last.start) <= DAYS_THRESHOLD\n  if (lastRangeTooShort) {\n    penultimate.end = last.end\n    ranges.pop()\n  }\n\n  return wrapRangesInStrings(ranges, monthId, timezone)\n}\n","import { now, toTimezone, parseISOToDateTime, toDateId } from '@calendly/datetime'\n\nimport { retrieveTimeNotation } from 'services/time_notation'\nimport { getMonthGetParam } from 'services/calendar'\n\nconst initialState = {\n  timeNotation: {\n    selected: null,\n    stored: retrieveTimeNotation()\n  },\n  today: now().toISO(),\n  initialMonthParam: getMonthGetParam(),\n  monthShift: 0,\n  spots: [],\n  selectedSpots: [],\n  selectedDaySpots: [],\n  conflictCheckQueue: [],\n  spotAutofocus: false,\n  inviteePublisherError: false,\n  bookingMethod: 'instant',\n  showSpotSelectionError: false\n}\n\nexport default (state = initialState, action) => {\n  let queue\n  let selectedSpots\n  let selectedDayId\n  let selectedStartTime\n  let selectedDaySpots\n  let selectedSpotIndex\n  let selectedDaySpotsIndex\n  let selectedSpotsByTimezone\n\n  switch (action.type) {\n    case 'SET_BOOKING_METHOD':\n      return {\n        ...state,\n        bookingMethod: action.bookingMethod,\n      }\n\n    case 'SELECT_CALENDAR_DAY': {\n      const normalizedDay = !action.day\n        ? action.day\n        : action.day.date != null\n          ? { ...action.day, date: toDateId(action.day.date) }\n          : { ...action.day }\n      return {\n        ...state,\n        day: normalizedDay,\n        spotAutofocus: Boolean(action.isFromKeyboard),\n        spots: []\n      }\n    }\n\n    case 'SELECT_SPOT_TIME':\n      return {\n        ...state,\n        spots: [action.spot]\n      }\n\n    case 'ADD_SPOT_FROM_PARAMS':\n      if (!action.spot) return state\n\n      selectedSpots = Array.from(state.selectedSpots)\n      selectedDaySpots = Array.from(state.selectedDaySpots)\n      selectedStartTime = action.spot.start_time.split('T')\n      selectedSpotIndex = selectedSpots.map((s) => s.start_time).indexOf(action.spot.start_time)\n\n      if (selectedSpotIndex >= 0) return state\n\n      selectedDaySpots.push(selectedStartTime[0])\n      selectedSpots.push(action.spot)\n\n      return {\n        ...state,\n        selectedSpots,\n        selectedDaySpots,\n        showSpotSelectionError: false\n      }\n\n    case 'ADD_OR_REMOVE_SPOT':\n      if (!action.spot) return state\n      selectedSpots = Array.from(state.selectedSpots)\n      selectedDaySpots = Array.from(state.selectedDaySpots)\n      selectedDayId = state.day.id\n\n      selectedSpotIndex = selectedSpots.map((s) => s.start_time).indexOf(action.spot.start_time)\n      if (selectedSpotIndex >= 0) {\n        selectedDaySpotsIndex = selectedDaySpots.indexOf(selectedDayId)\n        selectedDaySpots.splice(selectedDaySpotsIndex, 1)\n        selectedSpots.splice(selectedSpotIndex, 1)\n      } else {\n        selectedDaySpots.push(selectedDayId)\n        selectedSpots.push(action.spot)\n      }\n      return {\n        ...state,\n        selectedSpots,\n        selectedDaySpots,\n        showSpotSelectionError: false\n      }\n\n    case 'SPOT_SELECTION_ERROR':\n      return {\n        ...state,\n        showSpotSelectionError: true\n      }\n\n    case 'UPDATE_SELECTED_SPOTS':\n      selectedSpots = Array.from(state.selectedSpots)\n\n      return {\n        ...state,\n        selectedSpots: Array.from(new Set([\n          ...selectedSpots,\n          ...action.spots\n        ]))\n      }\n\n    case 'CLEAR_SPOTS':\n      return {\n        ...state,\n        selectedSpots: [],\n        selectedDaySpots: []\n      }\n\n    case 'SET_SELECTED_SPOTS':\n      return {\n        ...state,\n        selectedSpots: action.spots\n      }\n\n    case 'ADD_TO_CHECK_QUEUE':\n      queue = Array.from(state.conflictCheckQueue)\n      queue.unshift(action.spot.start_time)\n      return {\n        ...state,\n        conflictCheckQueue: queue\n      }\n\n    case 'REMOVE_FROM_CHECK_QUEUE':\n      if (!action.spot) return state\n      queue = Array.from(state.conflictCheckQueue)\n      queue.splice(queue.indexOf(action.spot.start_time), 1)\n      return {\n        ...state,\n        conflictCheckQueue: queue\n      }\n\n    case 'DESELECT_CALENDAR_DAY':\n      return {\n        ...state,\n        day: null\n      }\n\n    case 'CHANGE_CALENDAR_MONTH':\n      return {\n        ...state,\n        monthShift: state.monthShift + action.count\n      }\n\n    case 'CHANGE_TIME_NOTATION':\n      return {\n        ...state,\n        timeNotation: {\n          selected: action.notation,\n          stored: action.notation\n        }\n      }\n    case 'SET_INVITEE_PUBLISHER_ERROR':\n      return {\n        ...state,\n        inviteePublisherError: true\n      }\n\n    case 'UPDATE_SELECTED_SPOTS_BY_TIMEZONE':\n      selectedSpots = Array.from(state.selectedSpots)\n      selectedSpotsByTimezone = selectedSpots.map((spot) => ({\n        ...spot,\n        start_time: toTimezone(parseISOToDateTime(spot.start_time), action.timezone).toISO({\n          suppressMilliseconds: true\n        })\n      }))\n\n      return {\n        ...state,\n        selectedSpots: selectedSpotsByTimezone\n      }\n\n    default:\n      return state\n  }\n}\n","const initialState = {}\n\nexport default (state = initialState, action) => {\n  switch (action.type) {\n    case 'FETCH_CALENDAR_REQUEST':\n      return {\n        ...state,\n        options: {\n          calendarStatus: 'loading'\n        },\n        [action.payload.monthId]: {\n          status: 'loading',\n          lastLoadedDate: null,\n          days: []\n        }\n      }\n\n    case 'FETCH_CALENDAR_RANGE_DONE':\n      return {\n        ...state,\n        options: {\n          calendarStatus: 'loading'\n        },\n        [action.payload.monthId]: {\n          status: 'loading',\n          lastLoadedDate: action.payload.range_end,\n          days: Array.from(state[action.payload.monthId] ? state[action.payload.monthId].days : []).concat(action.payload.days)\n        }\n      }\n\n    case 'FETCH_CALENDAR_DONE':\n      return {\n        ...state,\n        options: {\n          calendarStatus: 'ready'\n        },\n        [action.payload.monthId]: {\n          ...state[action.payload.monthId],\n          status: 'ready',\n          receivedAt: Date.now(),\n          diagnostic_data: action.payload.diagnosticData\n        }\n      }\n\n    case 'FETCH_CALENDAR_FAIL':\n      return {\n        ...state,\n        options: {\n          calendarStatus: 'error'\n        },\n        [action.payload.monthId]: {\n          status: 'error',\n          days: []\n        }\n      }\n\n    case 'CLEAR_CALENDAR_DATA':\n      return initialState\n\n    default:\n      return state\n  }\n}\n","const initialState = {}\n\nexport 