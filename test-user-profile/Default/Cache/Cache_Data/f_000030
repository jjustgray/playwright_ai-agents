inviteeDataSelector(state, { formData }),\n    payment_token: paymentTokenSelector(state),\n    recaptcha_token_version_2: recaptchaV2Token,\n    tracking: trackingSelector(state),\n    scheduling_link_uuid: schedulingLink.uid,\n    booking_flow: formData.bookingFlow,\n    creator_uuid: formData.creatorUuid,\n    locale,\n    verification_code: verificationCode,\n    event_type_uuid: uuid,\n    booking_code: bookingCode,\n    purchased_package_uuid: purchasedPackage?.uuid,\n  }\n}\n\n/**\n * checkInviteeFingerprintFreshness()\n *\n * Using Stytch, invitees are fingerprinted upon reaching the booking app and then refreshed\n * periodically on a timer. If for some reason this timer-based method has failed and/or the\n * Stytch `telemetryId` is expired upon final booking submit, we will try one last time to\n * generate a fresh one. This is fallback to ensure we always have a `telemetryId` to lookup.\n *\n * @see apps/booking/frontend/contexts/TelemetryContext.js\n */\nconst checkInviteeFingerprintFreshness = async (state) => {\n  const telemetryId = state.tracking?.stytch_telemetry_id\n  const expiresAt = state.tracking?.stytch_telemetry_expires_at\n  const publicToken = Settings?.trust_and_safety?.stytch_public_token\n  const submitURL = 'https://dfp.calendly.com'\n  const refreshBefore = Settings?.trust_and_safety?.stytch_telemetry_expiry_buffer || 15_000\n  const timeUntilRefresh = expiresAt ? (expiresAt - Date.now() - refreshBefore) : -1\n  const SYNC_TELEMETRY_FETCH_SWITCH = Settings?.trust_and_safety?.stytch_telemetry_sync_fetch_switch || false\n\n  if (!publicToken) {\n    Logger.warn('Public token is missing. Skipping telemetry ID fetch.')\n    return undefined\n  }\n\n  // do nothing if switched off or when the existing fingerprint is not expiring soon\n  if (\n    !SYNC_TELEMETRY_FETCH_SWITCH\n    || (telemetryId && timeUntilRefresh > 0)\n  ) {\n    return undefined\n  }\n\n  try {\n    // Check if GetTelemetryID is available\n    if (typeof window.GetTelemetryID !== 'function') {\n      Logger.warn('GetTelemetryID function is not available - telemetry script may not have loaded')\n      return undefined\n    }\n\n    // Call GetTelemetryID with separate parameters (not an object)\n    const newTelemetryId = await window.GetTelemetryID(publicToken, submitURL)\n\n    return newTelemetryId\n  } catch (error) {\n    Logger.warn('Telemetry ID fetch failed:', error)\n  }\n\n  return undefined\n}\n\nconst hasCouponError = (success, responseData) => {\n  if (success) { return false }\n\n  if (responseData.type !== 'validation') { return false }\n  const payload = responseData.payload\n  if (!payload?.details) { return false }\n  return !!payload.details.find((detail) => detail.parameter === 'booking_code')\n}\n\n// Handles various booking failure scenarios - returns true if handled, false otherwise\nconst handleBookingFailure = async (dispatch, getState, success, responseData, context) => {\n  const { spotStartTime, formData, paymentApi, requestId, client, numRetries, verificationCode, scheduleFn } = context\n\n  if (cardActionRequired(success, responseData) && paymentApi && spotStartTime && formData) {\n    if (await paymentApi.handleCardAction(responseData.client_secret)) {\n      // send same schedule request again\n      dispatch(scheduleFn(spotStartTime, formData, paymentApi, requestId, client))\n    }\n    return true\n  }\n\n  if (duplicateBookingDetected(success, responseData) && numRetries <= 60 && paymentApi && spotStartTime && formData) {\n    const retryParams = [spotStartTime, formData, paymentApi, requestId, client, numRetries + 1, verificationCode]\n    setTimeout(() => dispatch(scheduleFn(...retryParams)), 500)\n    return true\n  }\n\n  if (isRecaptchaChallengeRequiredError(responseData.payload)) {\n    dispatch(showRecaptchaChallenge(requestId))\n\n    const state = getState()\n    const eventType = eventTypeSelector(state)\n    const telemetryId = state.tracking?.stytch_telemetry_id\n\n    eventService.dispatch({\n      name: 'ReCaptcha Interaction',\n      version: 2,\n      dependencies: {\n        user_uuid: eventType.owning_user.uuid,\n        organization_uuid: eventType.organization.uuid\n      },\n      entities: ['user', 'organization'],\n      properties: {\n        location: 'booking_page',\n        action: 'failure',\n        event_type_id: eventType.id,\n        event_type_uuid: eventType.uuid,\n        stytch_telemetry_id: telemetryId\n      }\n    })\n\n    return true\n  }\n\n  if (isRecaptchaChallengeFailedError(responseData.payload)) {\n    dispatch(recaptchaChallengeFailed())\n    return true\n  }\n\n  if (isVerificationCodeChallengeRequired(responseData.payload)) {\n    const schedulingParams = { spotStartTime, formData, paymentApi, requestId, client, numRetries }\n    dispatch(showVerificationCodeChallenge(schedulingParams, null))\n    return true\n  }\n\n  if (isVerificationCodeChallengeFailed(responseData.payload)) {\n    const schedulingParams = { spotStartTime, formData, paymentApi, requestId, client, numRetries }\n    const errorMessage = responseData.payload?.invitee?.verification_error\n    dispatch(showVerificationCodeChallenge(schedulingParams, errorMessage))\n    return true\n  }\n\n  if (hasCouponError(success, responseData)) {\n    dispatch(couponError(responseData))\n    return true\n  }\n\n  // Only call default error handler for actual errors, not successful responses\n  if (!success) {\n    dispatch(handleErrorResponse(responseData))\n    return true\n  }\n\n  return false\n}\n\nexport const schedule = (\n  spotStartTime,\n  formData,\n  paymentApi,\n  requestId,\n  client = false,\n  numRetries = 0,\n  verificationCode = null,\n) => async (dispatch, getState) => {\n  dispatch({ type: 'SCHEDULING_REQUEST' })\n\n  let state = getState()\n\n  // before finally submitting the booking request to backend, check if the fingerprint needs to be refreshed\n  const newTelemetryId = await checkInviteeFingerprintFreshness(state, dispatch)\n\n  