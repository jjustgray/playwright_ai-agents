lled: action.fields_filled\n      }\n\n    case 'FORM_UNMOUNTED':\n      return {\n        ...state,\n        fields_count: 0,\n        fields_filled: [],\n        builtEventCustomFields: []\n      }\n\n    case 'SELECT_LOCATION_CONFIGURATION':\n      return {\n        ...state,\n        location_configuration: {\n          ...state.location_configuration,\n          ...action.payload.location_configuration\n        }\n      }\n\n    case 'LOCATION_CHANGE':\n      return {\n        ...state,\n        location_configuration: {\n          ...state.location_configuration,\n          location: action.payload.location\n        }\n      }\n\n    case 'PHONE_NUMBER_CHANGE':\n      return {\n        ...state,\n        location_configuration: {\n          ...state.location_configuration,\n          phone_number: action.payload.phone_number.value,\n          phone_field: action.payload.phone_number,\n        }\n      }\n\n    case 'SCHEDULING_VALIDATION_REQUEST':\n      return {\n        ...state,\n        status: 'submitting'\n      }\n\n    case 'SCHEDULING_VALIDATION_DONE':\n      return {\n        ...state,\n        // Keep status as 'submitting' - don't reset to 'done' during submission flow\n        status: state.status\n      }\n\n    case 'SCHEDULING_VALIDATION_FAIL':\n      return {\n        ...state,\n        status: 'done',\n        error: {\n          type: 'validation',\n          payload: action.payload.errors\n        }\n      }\n\n    case 'SCHEDULING_PAYMENT_REQUEST':\n      return {\n        ...state,\n        status: 'submitting',\n        payment: {\n          status: 'requested',\n          data: null,\n          error: null\n        }\n      }\n\n    case 'SCHEDULING_PAYMENT_DONE':\n      return {\n        ...state,\n        // Keep status as is - payment completion is tracked separately\n        status: state.status,\n        payment: {\n          status: 'paid',\n          data: action.payload\n        }\n      }\n\n    case 'SCHEDULING_PAYMENT_ERROR':\n      return {\n        ...state,\n        status: 'done',\n        payment: {\n          status: 'unpaid',\n          error: action.payload.message\n        }\n      }\n\n    case 'SCHEDULING_PAYMENT_RESET':\n      return {\n        ...state,\n        status: 'done',\n        payment: {\n          status: 'unpaid',\n          data: null\n        }\n      }\n\n    case 'SCHEDULING_REQUEST':\n      return {\n        ...state,\n        status: 'submitting',\n        showExternalRedirect: false,\n        showPhoneVerification: false,\n        externalRedirectFormData: null,\n        recaptcha_challenge: {\n          ...state.recaptcha_challenge,\n          failed: false\n        }\n      }\n\n    case 'SCHEDULING_DONE':\n      return {\n        ...state,\n        status: 'done',\n        event: action.payload.event,\n        invitee: action.payload,\n        payment: {\n          status: 'unpaid',\n          data: null,\n          error: null\n        },\n        recaptcha_challenge: {\n          show: false,\n          failed: false\n        }\n      }\n\n    case 'SCHEDULING_SHOW_EXTERNAL_REDIRECT': {\n      return {\n        ...state,\n        showExternalRedirect: true,\n        externalRedirectFormData: null,\n      }\n    }\n\n    case 'SCHEDULING_SHOW_PHONE_VERIFICATION':\n      return {\n        ...state,\n        showPhoneVerification: true,\n        externalRedirectFormData: action.payload?.formData || null,\n      }\n\n    case 'SCHEDULING_FINISH_PHONE_VERIFICATION':\n      return {\n        ...state,\n        showPhoneVerification: false,\n        showExternalRedirect: true,\n        externalRedirectFormData: null,\n      }\n\n    case 'INTERCOM_SCHEDULING_DONE':\n      return {\n        ...state,\n        is_submitting_intercom: true,\n        status: 'submitting'\n      }\n\n    case 'SCHEDULING_FAIL':\n      return {\n        ...state,\n        status: 'done',\n        showExternalRedirect: false,\n        showPhoneVerification: false,\n        error: action.payload,\n        payment: {\n          ...state.payment,\n          // If scheduling fails, make sure we pull a new payment method\n          status: 'unpaid',\n          error: action.payload.payload && action.payload.payload.payment && action.payload.payload.payment.message\n        }\n      }\n\n    case 'DISMISS_SCHEDULE_VALIDATION_ERROR':\n      if (!(state.error && state.error.type === 'validation')) return state\n      if (\n        !(\n          state.error.payload\n          && state.error.payload[action.payload.model]\n          && state.error.payload[action.payload.model][action.payload.attribute]\n        )\n      ) {\n        return state\n      }\n\n      return {\n        ...state,\n        error: {\n          type: state.error.type,\n          payload: {\n            ...state.error.payload,\n            [action.payload.model]: {\n              ...state.error.payload[action.payload.model],\n              [action.payload.attribute]: undefined\n            }\n          }\n        }\n      }\n\n    case 'DISMISS_SCHEDULE_ERROR':\n      return {\n        ...state,\n        status: 'done',\n        error: null\n      }\n\n    case 'POLL_VOTES_REQUEST':\n      return {\n        ...state,\n        status: 'submitting'\n      }\n\n    case 'POLL_VOTES_SUCCESS':\n      return {\n        ...state,\n        status: 'done',\n        invitee: action.payload,\n        event: {\n          scheduled_profile: action.payload.scheduled_profile,\n          publishers_list: action.payload.publishers_list\n        }\n      }\n\n    case 'SHOW_RECAPTCHA_CHALLENGE':\n      return {\n        ...state,\n        status: 'done',\n        recaptcha_challenge: {\n          show: true,\n          failed: false,\n          request_id: action.payload?.requestId ?? null\n        }\n      }\n\n    case 'DISMISS_RECAPTCHA_CHALLENGE':\n      return {\n        ...state,\n        status: 'done',\n        recaptcha_challenge: {\n          show: false,\n          failed: false,\n    